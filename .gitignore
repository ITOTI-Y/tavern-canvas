node_modules/
.pnpm-store/
**/dist/
!/dist/
!/dist/**
# apps/extension's Vite build copies the committed vocabulary baseline
# (apps/extension/public/vocabulary/baseline, already tracked) verbatim into
# dist/vocabulary/ via copyPublicDir on every `pnpm build` -- a byte-identical
# duplicate of already-committed source, not new content (2,742 files / 14 MB
# at the current baseline size). Committing it too would double repo size and
# diff noise on every baseline rebuild for zero benefit; a real release still
# needs a fresh `pnpm build` locally before publishing dist/, same as
# dist/index.js and dist/index.css.
/dist/vocabulary/
.vite/
coverage/
playwright-report/
test-results/
output/
# Stage 05 Task 6: 500,000-record benchmark package staged into the
# harness's Vite publicDir by tests/harness/prepare_benchmark_site.mjs --
# regenerated on every benchmark run, never committed.
tests/harness/.benchmark_public/
.env
.env.*
!.env.example
*.sqlite
*.sqlite-shm
*.sqlite-wal
data/_archive/
docs/_dev/
data/vocabulary/*.jsonl
# Redistributable per explicit user decision (data/vocabulary/LICENSES.json):
# facts + zh translations. The sole permitted input for the committed
# apps/extension/public/vocabulary/baseline package and the (uncommitted,
# output/-shipped) full pack (see docs/_dev/DATA.md's
# processed-vocabulary-baseline-v1 entry).
!data/vocabulary/raw_vocabulary_tags_public.jsonl
.claude/
