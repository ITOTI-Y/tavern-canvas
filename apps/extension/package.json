{
  "name": "@tavern-canvas/extension",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/host/index.ts"
  },
  "scripts": {
    "build": "vite build && node scripts/assert_bundle.mjs",
    "build:debug": "vite build --mode debug && node scripts/assert_bundle.mjs",
    "test": "vitest run --root ../.. --project apps apps/extension",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@tanstack/vue-virtual": "3.13.35",
    "@tavern-canvas/contracts": "workspace:*",
    "@tavern-canvas/core": "workspace:*",
    "@tavern-canvas/providers": "workspace:*",
    "@tavern-canvas/storage": "workspace:*",
    "@tavern-canvas/vocabulary": "workspace:*",
    "lucide-vue-next": "1.0.0",
    "reka-ui": "2.10.1",
    "vue": "3.5.40",
    "vue-i18n": "11.4.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@tavern-canvas/vocabulary-builder": "workspace:*",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "fake-indexeddb": "6.2.5",
    "idb": "8.0.3",
    "jsdom": "27.4.0",
    "postcss": "8.5.25",
    "vite": "8.2.0",
    "vue-tsc": "3.3.9"
  }
}
