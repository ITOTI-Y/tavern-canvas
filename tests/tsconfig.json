{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "paths": {
      "@tavern-canvas/contracts": ["../packages/contracts/src/index.ts"],
      "@tavern-canvas/core": ["../packages/core/src/index.ts"],
      "@tavern-canvas/providers": ["../packages/providers/src/index.ts"],
      "@tavern-canvas/storage": ["../packages/storage/src/index.ts"],
      "@tavern-canvas/vocabulary": ["../packages/vocabulary/src/index.ts"],
      "@tavern-canvas/vocabulary-builder": ["../tools/vocabulary_builder/src/index.ts"],
      // "tests" is not a pnpm workspace member, so "vue" resolves through apps/extension.
      "vue": ["../apps/extension/node_modules/vue"]
    },
    // vite/client supplies the ambient declarations for Vite-only specifiers (`*.css?inline`, `*.png?url`).
    "types": ["node", "vitest/globals", "vite/client"]
  },
  "include": ["**/*.ts"]
}
