{
  "name": "@tavern-canvas/vocabulary-builder",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "vocabulary-builder": "./dist/index.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate-baseline": "tsx scripts/generate_baseline.ts",
    "generate-benchmark": "tsx src/generate_benchmark_fixture.ts",
    "build-package": "tsx src/index.ts build",
    "verify-package": "tsx src/index.ts verify",
    "test": "vitest run --root ../.. --project tools tools/vocabulary_builder",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "@noble/hashes": "2.2.0",
    "@tavern-canvas/contracts": "workspace:*",
    "@tavern-canvas/vocabulary-source": "workspace:*",
    "zod": "4.4.3"
  }
}
