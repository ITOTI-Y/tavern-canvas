{
  "name": "tavern-canvas",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm dev:studio",
    "dev:studio": "vite --config tests/harness/vite.config.studio.ts --host --port 5180 --strictPort",
    "dev:host": "vite --config tests/harness/vite.config.all_host.ts --host --port 5181 --strictPort",
    "dev:extension": "vite --config apps/extension/vite.config.dev.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm check:first-party && pnpm check:locale && pnpm check:bundle",
    "check:bundle": "pnpm --filter @tavern-canvas/bundle-budget build && node tools/bundle_budget/dist/index.js",
    "check:first-party": "pnpm --filter @tavern-canvas/first-party-check build && node tools/first_party_check/dist/index.js apps packages",
    "check:locale": "pnpm --filter @tavern-canvas/locale-check build && node tools/locale_check/dist/index.js",
    "check:release": "pnpm --filter @tavern-canvas/release-audit build && node tools/release_audit/dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "prepare:e2e": "node tests/harness/prepare_benchmark_package.mjs",
    "test:e2e:playwright": "playwright test",
    "package:extension": "pnpm --filter @tavern-canvas/package-extension build && node tools/package_extension/dist/index.js",
    "verify:checksum": "cd output/release && sha256sum --check tavern-canvas.zip.sha256",
    "verify:dist": "git diff --exit-code -- dist && test -z \"$(git ls-files --others --exclude-standard -- dist)\"",
    "verify:release": "pnpm check && pnpm prepare:e2e && pnpm test:e2e:playwright && pnpm package:extension && pnpm check:release output/release/tavern-canvas.zip && pnpm verify:checksum && pnpm verify:dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "pnpm prepare:e2e && pnpm test:e2e:playwright"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.9.0",
    "happy-dom": "20.11.1",
    "idb": "8.0.3",
    "prettier": "3.9.6",
    "tsx": "4.23.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "typescript-language-server": "5.3.0",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-eslint-parser": "10.4.1"
  }
}
